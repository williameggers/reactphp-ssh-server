parameters:
    level: max

    paths:
        - examples/
        - src/

    treatPhpDocTypesAsCertain: false
    ignoreErrors:
        # ignore undefined methods due to magic `__call()` method
        - identifier: missingType.iterableValue
        - identifier: method.unused
        - identifier: property.onlyWritten

        # FFI binds its symbols from libcrypto at runtime, so the EVP_* and ERR_* entry points
        # declared by the ML-KEM backend are invisible to static analysis.
        -
            identifier: method.notFound
            path: src/Crypto/MlKem768OpenSsl.php
